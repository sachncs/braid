# Environment variables for braid.
# Copy to `.env` and fill in.

# Hugging Face (for downloading backbone weights)
HF_TOKEN=
HF_HOME=./artifacts/hf

# OpenAI (for openaicompat server)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Redis (cache)
REDIS_URL=redis://localhost:6379/0

# Postgres (cflog, schema registry, replay storage)
POSTGRES_URL=postgres://braid:braid@localhost:5432/braid

# Kafka (streaming data sources)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=braid-events

# S3 (S3Parquet source / sink)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=braid-data

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=braid

# Jaeger
JAEGER_HOST=localhost
JAEGER_PORT=6831

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/braid-prom

# Tracker choice (aim, mlflow, wandb, tensorboard)
BRAID_TRACKER=aim
AIM_DIR=./artifacts/aim

# Vault (for production secret loading)
VAULT_URL=https://vault.example.com
VAULT_TOKEN=

# Logging
BRAID_LOG_LEVEL=INFO
BRAID_LOG_FORMAT=json

# Model serving
BRAID_SERVER_HOST=0.0.0.0
BRAID_SERVER_PORT=8080
