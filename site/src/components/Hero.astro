---
import { Terminal } from "./Terminal.tsx";
---

<section
  class="relative overflow-hidden pt-12 pb-24 md:pt-20 md:pb-32"
>
  <div class="ring-glow absolute inset-x-0 top-0 -z-10 h-[640px]"></div>
  <div class="grid-bg absolute inset-0 -z-10 opacity-[0.85]"></div>

  <div class="container-page relative">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-7 flex justify-center">
        <span
          class="eyebrow rounded-full px-3 py-1.5 ring-soft"
          style="background:var(--bg-elev);"
        >
          <span class="relative inline-flex h-1.5 w-1.5">
            <span class="absolute inset-0 animate-ping rounded-full bg-[var(--accent)] opacity-60"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
          </span>
          v0.1.0 · public alpha
        </span>
      </div>

      <h1
        class="display text-[clamp(2.6rem,7.6vw,5.6rem)] tracking-[-0.04em]"
      >
        <span class="block">Braiding signals</span>
        <span class="block gradient-text">into ranks.</span>
      </h1>

      <p
        class="mx-auto mt-7 max-w-2xl text-balance text-[1.08rem] leading-[1.55] text-[var(--fg-muted)] md:text-[1.18rem]"
        style="letter-spacing:-0.011em;"
      >
        A polymorphic, LLM-backed ranker for catalog-aware recommendations.
        Every backbone, store, reward, and loss is a registered concrete — swappable
        from one config, runnable from one CLI.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="#docs" class="btn btn-primary">
          Read the docs
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href="https://github.com/sachncs/braid"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.11.79-.25.79-.56v-2.13c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.69.08-.69 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.12 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
            ></path>
          </svg>
          View source
        </a>
      </div>

      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-[12.5px] text-[var(--fg-muted)]"
      >
        <span class="inline-flex items-center gap-1.5">
          <svg
            class="h-3.5 w-3.5 text-[var(--accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
          MIT licensed
        </span>
        <span class="hidden h-3 w-px bg-[var(--line)] sm:inline-block"></span>
        <span>Python 3.11 · 3.12</span>
        <span class="hidden h-3 w-px bg-[var(--line)] sm:inline-block"></span>
        <span>Patterned on Netflix GenRec</span>
        <span class="hidden h-3 w-px bg-[var(--line)] sm:inline-block"></span>
        <span>CPU / MPS-runnable</span>
      </div>
    </div>

    <div class="relative mx-auto mt-16 max-w-5xl md:mt-20">
      <Terminal client:load />
    </div>
  </div>
</section>
