---
const features = [
  {
    eyebrow: "Polymorphic spine",
    title: "One registry, every primitive.",
    body:
      "Backbones, catalog stores, verbalizers, rewards, losses, evaluators, routers — every component is a registered concrete dispatched through `braid.registry.create(category, name, **cfg)`.",
    detail: "44 categories · 147 concretes",
    icon: "registry",
  },
  {
    eyebrow: "Braided loss",
    title: "Weighted-sum ranking objectives.",
    body:
      "`braidedloss` combines ranking-CE, L-max, diversity entropy, and reward-weighted terms into a single trainable scalar — without silent fallbacks.",
    detail: "Σ wᵢ · lossᵢ(scores, labels, …)",
    icon: "loss",
  },
  {
    eyebrow: "Catalog-aware",
    title: "Matmul, int4 AWQ, FAISS, RQ-VAE.",
    body:
      "Scoring is `h @ E.T` over embeddings. Swap in `matmulinmem`, `matmulint4awq`, `faissivfstore`, or RQ-VAE semantic IDs from one config field — same dispatch API.",
    detail: "≤1M items → matmul · ≥1M → FAISS",
    icon: "catalog",
  },
  {
    eyebrow: "Multi-reward",
    title: "Composite rewards, real math.",
    body:
      "Long-term return, diversity bonus, novelty, content-type balance — and a `composite` that weighted-sums them at training time. All real implementations, not stubs.",
    detail: "Trainable · deterministic · inspectable",
    icon: "reward",
  },
];
---

<section
  id="features"
  class="relative scroll-mt-24 py-28 md:py-36"
>
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow">What's inside</span>
      <h2
        class="display mt-5 text-[clamp(2rem,5vw,3.6rem)] tracking-[-0.035em]"
      >
        <span class="block">A complete ranker,</span>
        <span class="block">pluggable end-to-end.</span>
      </h2>
      <p
        class="mx-auto mt-6 max-w-2xl text-[1.05rem] leading-[1.55] text-[var(--fg-muted)]"
      >
        braid ships four backbones, four catalog stores, three verbalizer
        families, five real rewards, six loss terms, seven evaluators, and four
        drift detectors — all reachable through one dispatch.
      </p>
    </div>

    <div class="mt-16 grid gap-4 md:grid-cols-2">
      {
        features.map((f) => (
          <article class="card relative overflow-hidden p-7 md:p-8 transition-transform duration-500 hover:-translate-y-1">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full opacity-0 transition-opacity duration-700 group-hover:opacity-100"
              style="background:radial-gradient(closest-side, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%);"
            />
            <div class="flex items-center justify-between">
              <span class="eyebrow">{f.eyebrow}</span>
              <span class="inline-grid h-9 w-9 place-items-center rounded-xl ring-soft">
                {f.icon === "registry" && (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                  </svg>
                )}
                {f.icon === "loss" && (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 17 9 11l4 4 8-8"></path>
                    <path d="M14 7h7v7"></path>
                  </svg>
                )}
                {f.icon === "catalog" && (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse>
                    <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path>
                    <path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"></path>
                  </svg>
                )}
                {f.icon === "reward" && (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2 14.5 8.5 21 9.5l-5 4.5L17.5 21 12 17.5 6.5 21 8 14 3 9.5l6.5-1z"></path>
                  </svg>
                )}
              </span>
            </div>
            <h3
              class="display mt-5 text-[clamp(1.4rem,2.2vw,1.8rem)] tracking-[-0.03em]"
            >
              {f.title}
            </h3>
            <p class="mt-3 text-[14.5px] leading-[1.6] text-[var(--fg-muted)]">
              {f.body}
            </p>
            <div
              class="mt-6 flex items-center gap-2 border-t border-[var(--line-soft)] pt-4 font-mono text-[12px] text-[var(--fg-muted)]"
            >
              <span class="text-[var(--accent)]">›</span>
              <span>{f.detail}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
