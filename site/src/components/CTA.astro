---
const install = `git clone https://github.com/sachncs/braid
cd braid && make bootstrap
make list          # 44 categories × 147 concretes
make conformance   # 131 / 147 real-pass`;
---

<section
  id="docs"
  class="relative scroll-mt-24 py-28 md:py-36"
>
  <div class="container-page">
    <div
      class="card relative overflow-hidden p-10 md:p-16"
      style="background:linear-gradient(135deg, color-mix(in oklab, var(--accent) 18%, var(--bg-elev)) 0%, var(--bg-elev) 60%);"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full opacity-50 glow-blur"
        style="background:radial-gradient(closest-side, var(--accent), transparent 70%);"
      ></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-32 -left-20 h-80 w-80 rounded-full opacity-40 glow-blur"
        style="background:radial-gradient(closest-side, color-mix(in oklab, var(--color-ember-400) 60%, transparent), transparent 70%);"
      ></div>

      <div class="relative grid items-center gap-10 md:grid-cols-[1.1fr_1fr]">
        <div>
          <span class="eyebrow">Get started</span>
          <h2
            class="display mt-5 text-[clamp(2rem,4.6vw,3.2rem)] tracking-[-0.035em]"
          >
            <span class="block">Ship a ranker this</span>
            <span class="block gradient-text">afternoon.</span>
          </h2>
          <p
            class="mt-5 max-w-md text-[1.02rem] leading-[1.55] text-[var(--fg-muted)]"
          >
            Bootstrap a working environment, inspect the registry, dryrun any
            config, then start ranking — without Kubernetes, without Kafka,
            without a separately-licensed inference engine.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="https://github.com/sachncs/braid"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.11.79-.25.79-.56v-2.13c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.69.08-.69 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.12 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
                ></path>
              </svg>
              Star on GitHub
            </a>
            <a
              href="https://github.com/sachncs/braid/blob/master/README.md"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost"
            >
              Read the README
            </a>
          </div>
        </div>

        <div class="relative">
          <div
            class="card overflow-hidden ring-firm"
            style="background:linear-gradient(180deg, var(--bg-elev) 0%, color-mix(in oklab, var(--bg-elev) 92%, var(--accent-soft)) 100%);"
          >
            <div
              class="flex items-center justify-between border-b border-[var(--line-soft)] px-4 py-2.5"
            >
              <div class="flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-[#FF5F57]/80"></span>
                <span class="h-2 w-2 rounded-full bg-[#FEBC2E]/80"></span>
                <span class="h-2 w-2 rounded-full bg-[#28C840]/80"></span>
              </div>
              <span
                class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-[var(--fg-muted)]"
                >bootstrap</span
              >
              <span></span>
            </div>
            <pre
              class="overflow-x-auto p-5 font-mono text-[12.5px] leading-[1.75]"
            ><code><span style="color:var(--accent);">$</span> <span style="color:var(--fg);">git clone</span> https://github.com/sachncs/braid
<span style="color:var(--fg);">$</span> <span style="color:var(--fg);">cd</span> braid <span style="color:var(--fg);">&amp;&amp;</span> make bootstrap
<span style="color:var(--fg);">$</span> make list         <span style="color:var(--fg-muted);"># 44 categories × 147 concretes</span>
<span style="color:var(--fg);">$</span> make conformance  <span style="color:var(--fg-muted);"># 131 / 147 real-pass</span>

<span style="color:var(--fg-muted);"># python -m braid serve   → :8080</span></code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
