---
import Logo from "./Logo.astro";

const links = [
  { href: "#features", label: "Features" },
  { href: "#architecture", label: "Architecture" },
  { href: "#registry", label: "Registry" },
  { href: "#use-cases", label: "Use cases" },
];
---

<header
  id="top"
  class="sticky top-0 z-50 w-full transition-all duration-300"
  data-nav
>
  <div
    class="absolute inset-x-0 top-0 -z-10 h-full backdrop-blur-xl transition-opacity duration-300 opacity-0"
    data-nav-bg
    style="background:color-mix(in oklab, var(--bg) 78%, transparent);border-bottom:1px solid transparent;"
  ></div>

  <div class="container-page">
    <nav
      class="flex h-16 items-center justify-between"
      aria-label="Primary"
    >
      <Logo />

      <div class="hidden items-center gap-7 md:flex">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="text-[0.93rem] font-medium text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)]"
            >
              {l.label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          aria-label="Toggle theme"
          class="grid h-9 w-9 place-items-center rounded-full text-[var(--fg-muted)] transition-colors hover:bg-[color-mix(in_oklab,var(--fg)_6%,transparent)] hover:text-[var(--fg)]"
          data-theme-toggle
        >
          <svg
            class="hidden h-4 w-4 dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
          <svg
            class="block h-4 w-4 dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"></path>
          </svg>
        </button>

        <a
          href="https://github.com/sachncs/braid"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost hidden sm:inline-flex"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.11.79-.25.79-.56v-2.13c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.69.08-.69 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.12 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
            ></path>
          </svg>
          GitHub
        </a>

        <a href="#docs" class="btn btn-primary">
          Get started
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector("[data-nav]") as HTMLElement | null;
  const bg = document.querySelector("[data-nav-bg]") as HTMLElement | null;
  const onScroll = () => {
    const y = window.scrollY;
    if (!nav || !bg) return;
    if (y > 8) {
      bg.style.opacity = "1";
      (bg.style as any).borderBottomColor = "var(--line)";
    } else {
      bg.style.opacity = "0";
      (bg.style as any).borderBottomColor = "transparent";
    }
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const root = document.documentElement;
  const stored = localStorage.getItem("braid-theme");
  if (stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches)) {
    root.classList.add("dark");
  } else {
    root.classList.remove("dark");
  }
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      root.classList.toggle("dark");
      localStorage.setItem("braid-theme", root.classList.contains("dark") ? "dark" : "light");
    });
  });
</script>
