---
import Logo from "./Logo.astro";
const year = new Date().getFullYear();

const cols = [
  {
    title: "Product",
    links: [
      { href: "#features", label: "Features" },
      { href: "#architecture", label: "Architecture" },
      { href: "#registry", label: "Registry" },
      { href: "#use-cases", label: "Use cases" },
    ],
  },
  {
    title: "Resources",
    links: [
      {
        href: "https://github.com/sachncs/braid/blob/master/README.md",
        label: "README",
        external: true,
      },
      {
        href: "https://github.com/sachncs/braid/blob/master/docs/architecture.md",
        label: "Architecture guide",
        external: true,
      },
      {
        href: "https://github.com/sachncs/braid/blob/master/docs/serving_guide.md",
        label: "Serving guide",
        external: true,
      },
      {
        href: "https://github.com/sachncs/braid/blob/master/CHANGELOG.md",
        label: "Changelog",
        external: true,
      },
    ],
  },
  {
    title: "Community",
    links: [
      {
        href: "https://github.com/sachncs/braid/blob/master/CONTRIBUTING.md",
        label: "Contributing",
        external: true,
      },
      {
        href: "https://github.com/sachncs/braid/blob/master/CODE_OF_CONDUCT.md",
        label: "Code of Conduct",
        external: true,
      },
      {
        href: "https://github.com/sachncs/braid/blob/master/SECURITY.md",
        label: "Security",
        external: true,
      },
      {
        href: "https://github.com/sachncs/braid/issues",
        label: "Issues",
        external: true,
      },
    ],
  },
];
---

<footer class="relative border-t border-[var(--line-soft)] pt-20 pb-12">
  <div class="container-page">
    <div class="grid gap-10 md:grid-cols-[1.3fr_repeat(3,1fr)]">
      <div>
        <Logo size={26} />
        <p class="mt-5 max-w-xs text-[13.5px] leading-[1.6] text-[var(--fg-muted)]">
          A polymorphic, LLM-backed recommendation ranker. Every primitive is a
          registered concrete. MIT licensed.
        </p>

        <div class="mt-6 flex items-center gap-2">
          <a
            href="https://github.com/sachncs/braid"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="grid h-9 w-9 place-items-center rounded-full text-[var(--fg-muted)] ring-soft transition-colors hover:bg-[color-mix(in_oklab,var(--fg)_5%,transparent)] hover:text-[var(--fg)]"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="currentColor"
              aria-hidden="true"
              ><path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.11.79-.25.79-.56v-2.13c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.69.08-.69 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.12 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/sachncs/braid/blob/master/LICENSE"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="License"
            class="grid h-9 w-9 place-items-center rounded-full text-[var(--fg-muted)] ring-soft transition-colors hover:bg-[color-mix(in_oklab,var(--fg)_5%,transparent)] hover:text-[var(--fg)]"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="9"></circle><path
                d="M9 9.5a3 3 0 1 1 4.5 2.6c-.7.4-1.5 1-1.5 1.9"></path><path
                  d="M12 17h.01"></path></svg
            >
          </a>
        </div>
      </div>

      {
        cols.map((c) => (
          <div>
            <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--fg-muted)]">
              {c.title}
            </div>
            <ul class="mt-5 space-y-3">
              {c.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.external ? "_blank" : undefined}
                    rel={l.external ? "noopener noreferrer" : undefined}
                    class="text-[14px] text-[var(--fg-soft)] transition-colors hover:text-[var(--accent)]"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-[var(--line-soft)] pt-8 text-[12.5px] text-[var(--fg-muted)] md:flex-row md:items-center"
    >
      <div>
        © {year} braid contributors · Released under the
        <a
          class="underline-offset-4 hover:underline"
          href="https://github.com/sachncs/braid/blob/master/LICENSE"
          target="_blank"
          rel="noopener noreferrer">MIT License</a
        >.
      </div>
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-2">
          <span class="relative inline-flex h-1.5 w-1.5">
            <span
              class="absolute inset-0 animate-ping rounded-full bg-[var(--accent)] opacity-60"
            ></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[var(--accent)]"
            ></span>
          </span>
          v0.1.0 · alpha
        </span>
        <span class="hidden h-3 w-px bg-[var(--line)] md:inline-block"></span>
        <a
          href="https://github.com/sachncs/braid"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--fg)]"
          >github.com/sachncs/braid</a
        >
      </div>
    </div>
  </div>
</footer>
