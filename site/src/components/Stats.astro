---
const stats = [
  { value: "44", label: "categories", sub: "polymorphic registry" },
  { value: "147", label: "concretes", sub: "real implementations" },
  { value: "131 / 147", label: "conformance", sub: "fail-fast, no stubs" },
  { value: "277", label: "tests passing", sub: "+ 1 skipped" },
];
---

<section class="border-y border-[var(--line-soft)] bg-[var(--bg-elev)]">
  <div class="container-page">
    <dl
      class="grid grid-cols-2 divide-x divide-[var(--line-soft)] md:grid-cols-4"
    >
      {
        stats.map((s, i) => (
          <div class={`px-2 py-8 text-center md:py-10 ${i === 0 ? "border-l border-[var(--line-soft)] md:border-l-0" : ""}`}>
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <div
                class="display text-[clamp(2rem,4.5vw,3.4rem)] tracking-[-0.04em]"
              >
                {s.value}
              </div>
              <div class="mt-2 text-[13px] font-medium tracking-wide text-[var(--fg)]">
                {s.label}
              </div>
              <div class="mt-0.5 text-[12px] text-[var(--fg-muted)]">
                {s.sub}
              </div>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
