---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Marquee from "../components/Marquee.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Architecture from "../components/Architecture.astro";
import CodeShowcase from "../components/CodeShowcase.astro";
import Registry from "../components/Registry.astro";
import UseCases from "../components/UseCases.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <main class="surface">
    <Hero />
    <Stats />
    <Marquee />
    <FeatureGrid />
    <Architecture />
    <CodeShowcase />
    <Registry />
    <UseCases />
    <CTA />
  </main>
  <Footer />
</Base>
